# ────────────────────────────────────────────────────────────
# TEBM V3 — .gitignore
# ────────────────────────────────────────────────────────────

# Env
.env

# ── Backend (Maven / Java) ──────────────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties
backend/*.class

# ── Frontend (Node / Angular) ───────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/

# ── IDE ─────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.user

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Docker volumes (local data) ─────────────────────────────
# (volumes managed by Docker, not tracked here)
